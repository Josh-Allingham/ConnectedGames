--- !u!1001 &6537475825033149822
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 439097041}
    m_Modifications:
    - target: {fileID: 2881470421935706605, guid: e29068dc383eb4946b3719213c904914, type: 3}
      propertyPath: evilBabble
      value: 
      objectReference: {fileID: 8300000, guid: 3111a63ef3ff011408dc4646d6bde180, type: 3}
    - target: {fileID: 2881470421935706605, guid: e29068dc383eb4946b3719213c904914, type: 3}
      propertyPath: niceBabble
      value: 
      objectReference: {fileID: 8300000, guid: f1aa187156131974fa4e4f3a54671277, type: 3}
    - target: {fileID: 2881470421935706605, guid: e29068dc383eb4946b3719213c904914, type: 3}
      propertyPath: newSpawnPos
      value: 
      objectReference: {fileID: 837075408}
    - target: {fileID: 2881470421935706605, guid: e29068dc383eb4946b3719213c904914, type: 3}
      propertyPath: highlightText
      value: '[F]'
      objectReference: {fileID: 0}
    - target: {fileID: 2881470421935706605, guid: e29068dc383eb4946b3719213c904914, type: 3}
      propertyPath: dialogueStrings.Array.size
      value: 9
      objectReference: {fileID: 0}
    - target: {fileID: 2881470421935706605, guid: e29068dc383eb4946b3719213c904914, type: 3}
      propertyPath: 'dialogueStrings.Array.data[0]'
      value: Hey, you there
      objectReference: {fileID: 0}
    - target: {fileID: 2881470421935706605, guid: e29068dc383eb4946b3719213c904914, type: 3}
      propertyPath: 'dialogueStrings.Array.data[1]'
      value: Another band of drifters, daring to test their luck. How many more will
        come, I wonder?
      objectReference: {fileID: 0}
    - target: {fileID: 2881470421935706605, guid: e29068dc383eb4946b3719213c904914, type: 3}
      propertyPath: 'dialogueStrings.Array.data[2]'
      value: "I will no longer allow the unworthy to pass. If you value your lives,
        turn back now\u2026 return to whatever place you still call home."
      objectReference: {fileID: 0}
    - target: {fileID: 2881470421935706605, guid: e29068dc383eb4946b3719213c904914, type: 3}
      propertyPath: 'dialogueStrings.Array.data[3]'
      value: "\u2026Or prove yourselves worthy."
      objectReference: {fileID: 0}
    - target: {fileID: 2881470421935706605, guid: e29068dc383eb4946b3719213c904914, type: 3}
      propertyPath: 'dialogueStrings.Array.data[4]'
      value: "Show me that you possess the strength\u2026 the skill\u2026 the will
        to survive."
      objectReference: {fileID: 0}
    - target: {fileID: 2881470421935706605, guid: e29068dc383eb4946b3719213c904914, type: 3}
      propertyPath: 'dialogueStrings.Array.data[5]'
      value: Do you see those windmills in the distance?
      objectReference: {fileID: 0}
    - target: {fileID: 2881470421935706605, guid: e29068dc383eb4946b3719213c904914, type: 3}
      propertyPath: 'dialogueStrings.Array.data[6]'
      value: "Bring them to life. Set them turning with your own power\u2026 or accept
        your weakness\u2026"
      objectReference: {fileID: 0}
    - target: {fileID: 2881470421935706605, guid: e29068dc383eb4946b3719213c904914, type: 3}
      propertyPath: 'dialogueStrings.Array.data[7]'
      value: "\u2026and walk away."
      objectReference: {fileID: 0}
    - target: {fileID: 2881703987484729657, guid: e29068dc383eb4946b3719213c904914, type: 3}
      propertyPath: m_Name
      value: Old Man
      objectReference: {fileID: 0}
    - target: {fileID: 3299701903062326191, guid: e29068dc383eb4946b3719213c904914, type: 3}
      propertyPath: m_LocalScale.x
      value: 2
      objectReference: {fileID: 0}
